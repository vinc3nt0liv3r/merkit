<UserControl x:Class="Merkit.App.Views.AuditDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Audit log" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding Integrity}" Margin="0,6,0,0" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IntegrityKind}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding IntegrityKind}" Value="Critical"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"/>
        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="1.3*" MinWidth="110"/>
        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/>
        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" MinWidth="140"/>
        <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100"/>
        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" MinWidth="140"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Verify log" Command="{Binding VerifyCommand}" Margin="0,0,8,0" MinWidth="100"/>
      <Button Content="Close" Command="{Binding CloseCommand}" MinWidth="90" IsCancel="True"/>
    </StackPanel>
  </Grid>
</UserControl>
