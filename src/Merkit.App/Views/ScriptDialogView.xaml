<UserControl x:Class="Merkit.App.Views.ScriptDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Export" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding Dn}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Tab, Mode=TwoWay}" Margin="0,0,0,8" BorderThickness="0,0,0,1">
      <TabItem Header="PowerShell script"/>
      <TabItem Header="C# program"/>
      <TabItem Header="CSV (permissions list)"/>
    </TabControl>
    <TextBox Grid.Row="2" Text="{Binding CurrentText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Copy" Command="{Binding CopyCommand}" Margin="0,0,8,0" MinWidth="90"/>
      <Button Content="Save as file..." Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="120"/>
      <Button Content="Close" Command="{Binding CloseCommand}" MinWidth="90" IsCancel="True"/>
    </StackPanel>
  </Grid>
</UserControl>
