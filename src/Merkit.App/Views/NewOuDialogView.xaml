<UserControl x:Class="Merkit.App.Views.NewOuDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="New organizational unit" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding ParentDn}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
              Visibility="{Binding WriteEnabled, Converter={StaticResource InvBoolToVis}}">
        <TextBlock Text="Write mode is off. Turn it on in the toolbar to create an OU." Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"/>
      <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
      <CheckBox Content="Protect from accidental deletion (recommended)" IsChecked="{Binding Protect}" Margin="0,12,0,0"/>
      <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
              Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" IsCancel="True"/>
      <Button Content="Create OU" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" MinWidth="110" Padding="14,7" IsDefault="True"/>
    </StackPanel>
  </Grid>
</UserControl>
