<UserControl x:Class="Merkit.App.Views.VaultDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Backup vault" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Merkit saves the permissions of an object before every change. Each backup carries a checksum so damage or tampering is detected before a restore."/>
      <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0"/>
      <CheckBox Content="Only the selected object" IsChecked="{Binding OnlyCurrent}" Margin="0,10,0,0"
                Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150"/>
        <DataGridTextColumn Header="Object" Binding="{Binding Target}" Width="2*" MinWidth="160"/>
        <DataGridTextColumn Header="Entries" Binding="{Binding Entries}" Width="70"/>
        <DataGridTextColumn Header="By" Binding="{Binding User}" Width="1.2*" MinWidth="100"/>
        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" MinWidth="120"/>
        <DataGridTextColumn Header="Check" Binding="{Binding Integrity}" Width="80"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="2" Text="{Binding Details}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
               Visibility="{Binding Details, Converter={StaticResource TextToVis}}"/>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding RestoreHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Close" Command="{Binding CloseCommand}" Margin="0,0,8,0" MinWidth="90" IsCancel="True"/>
        <Button Content="Stage restore..." Style="{StaticResource PrimaryButton}" Command="{Binding RestoreCommand}" MinWidth="130" Padding="14,7"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
