<UserControl x:Class="Merkit.App.Views.ReviewDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Review the changes" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding Dn}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Warnings}" Margin="0,0,0,10">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <ListBox ItemsSource="{Binding Lines}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" x:Name="Kind"/>
              <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Kind}" Value="Remove"><Setter TargetName="Kind" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="Add"><Setter TargetName="Kind" Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="Reason for this change (kept in the audit log and the backup)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"/>
      <CheckBox Margin="0,12,0,0" IsChecked="{Binding Acknowledged}" VerticalContentAlignment="Top">
        <TextBlock TextWrapping="Wrap" MaxWidth="700"
                   Text="I have reviewed these changes. Merkit will back up the current permissions first, write the change, check the result and roll back if anything is wrong."/>
      </CheckBox>
      <TextBlock Text="{Binding BlockedMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                 Visibility="{Binding BlockedMessage, Converter={StaticResource TextToVis}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" IsCancel="True"/>
        <Button Content="Apply changes" Style="{StaticResource DangerButton}" Command="{Binding ConfirmCommand}" MinWidth="130" Padding="14,7"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
