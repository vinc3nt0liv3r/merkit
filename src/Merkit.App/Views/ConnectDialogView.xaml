<UserControl x:Class="Merkit.App.Views.ConnectDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24,20,24,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock Text="Connect to Active Directory" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Merkit uses the account you are signed in with. It never stores a password. The connection is always encrypted."/>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="Domain (DNS name)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Find domain controllers" Command="{Binding FindControllersCommand}" VerticalAlignment="Bottom" Padding="12,7"/>
      </Grid>

      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="Domain controller (server)" Style="{StaticResource FieldLabel}"/>
          <ComboBox IsEditable="True" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DomainControllers}"
                    SelectedItem="{Binding SelectedDc, Mode=TwoWay}" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Port (optional)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <TextBlock Text="Connection security" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding SecurityModes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label"/>
      </StackPanel>

      <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <CheckBox Content="Sign in with a different account" IsChecked="{Binding UseAlternateCredentials}" Margin="0,0,0,8"/>
        <Grid Visibility="{Binding UseAlternateCredentials, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="User name (DOMAIN\user or user@domain)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Password (used for this connection only)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="Password"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <StackPanel Grid.Row="5" Margin="0,16,0,0">
        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding Info, Converter={StaticResource NullToVis}}">
          <TextBlock Text="{Binding Info}" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
        </Border>
        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90" IsCancel="True"/>
          <Button Content="Connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" MinWidth="110" Padding="14,7" IsDefault="True"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
