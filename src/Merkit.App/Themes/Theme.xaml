<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette: charcoal and amber from the Merkit icon, light surfaces for dense data. -->
  <SolidColorBrush x:Key="BgBrush" Color="#F4F5F7"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F8FA"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#D5D9E0"/>
  <SolidColorBrush x:Key="BorderSoftBrush" Color="#E7E9EE"/>
  <SolidColorBrush x:Key="TextBrush" Color="#1B1F27"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6372"/>
  <SolidColorBrush x:Key="HeaderBgBrush" Color="#171717"/>
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="HeaderMutedBrush" Color="#A8A8A8"/>
  <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B"/>
  <SolidColorBrush x:Key="AmberDarkBrush" Color="#B45309"/>
  <SolidColorBrush x:Key="AmberSoftBrush" Color="#FFF6DD"/>
  <SolidColorBrush x:Key="AmberTextBrush" Color="#6B3F00"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#FFE9B8"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE4E2"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#9A5B00"/>
  <SolidColorBrush x:Key="WarnSoftBrush" Color="#FEF0C7"/>
  <SolidColorBrush x:Key="OkBrush" Color="#05603A"/>
  <SolidColorBrush x:Key="OkSoftBrush" Color="#DCFAE6"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#1849A9"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#D1E9FF"/>
  <SolidColorBrush x:Key="RowCriticalBrush" Color="#FEF3F2"/>
  <SolidColorBrush x:Key="RowWarnBrush" Color="#FFFAEB"/>
  <SolidColorBrush x:Key="RowProtectedBrush" Color="#ECFDF3"/>
  <SolidColorBrush x:Key="RowNewBrush" Color="#EAF4FF"/>

  <FontFamily x:Key="MonoFont">Consolas</FontFamily>
  <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

  <!-- Text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="0,10,0,2"/>
  </Style>
  <Style x:Key="FieldValue" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <!-- Buttons: one template; the variants only change colours. Hover and press are a translucent overlay so they work on any colour. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="Overlay" Background="#18000000" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="#30000000"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
    <Setter Property="Foreground" Value="#1B1304"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="#404040"/>
    <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="11,5"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
  </Style>

  <!-- Inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="7,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Padding" Value="7,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="7,6"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,0,14,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <!-- Cards -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <!-- Summary chips -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="Background" Value="#EAECF0"/>
  </Style>

  <!-- Data grid -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoftBrush}"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="RowHeight" Value="32"/>
    <Setter Property="ColumnHeaderHeight" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#EEF0F4"/>
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabs -->
  <Style TargetType="TabControl">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
  </Style>
</ResourceDictionary>
