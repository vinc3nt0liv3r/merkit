<Application x:Class="Merkit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Merkit.App.ViewModels"
             xmlns:v="clr-namespace:Merkit.App.Views"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      <v:NullToVisibilityConverter x:Key="NullToVis"/>
      <v:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
      <v:TextToVisibilityConverter x:Key="TextToVis"/>
      <v:CountToVisibilityConverter x:Key="CountToVis"/>

      <!-- Coloured dot that shows how serious a finding is. -->
      <Style x:Key="SeverityDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="#9AA3B2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding SeverityKey}" Value="Protected"><Setter Property="Fill" Value="{StaticResource OkBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding SeverityKey}" Value="Warning"><Setter Property="Fill" Value="{StaticResource AmberBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding SeverityKey}" Value="Critical"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Which view shows which dialog. -->
      <DataTemplate DataType="{x:Type vm:MessageDialogViewModel}"><v:MessageDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ConnectDialogViewModel}"><v:ConnectDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ReviewDialogViewModel}"><v:ReviewDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:TemplateDialogViewModel}"><v:TemplateDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:VaultDialogViewModel}"><v:VaultDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ScriptDialogViewModel}"><v:ScriptDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ImportDialogViewModel}"><v:ImportDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:NewOuDialogViewModel}"><v:NewOuDialogView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:AuditDialogViewModel}"><v:AuditDialogView/></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
